# YouCam API key: https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Anthropic API key for tagging clothes and proposing outfits
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

PORT=4320

# Optional spending limits (defaults shown)
# LIMIT_CLAUDE_PER_HOUR=100
# LIMIT_CLAUDE_PER_DAY=500
# LIMIT_RENDER_STEPS_PER_HOUR=30
# LIMIT_RENDER_STEPS_PER_DAY=150

# Set to 1 when the app runs behind a host proxy (Render does), so per-visitor limits use the visitor's address
# TRUST_PROXY=1
